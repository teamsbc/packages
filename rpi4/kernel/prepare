#!/usr/bin/env bash
set -euo pipefail

SOURCE_DIR=$(cd "$(dirname "$0")" && pwd)
BUILD_DIR=$(cd "$1" && pwd)
source "$SOURCE_DIR/source.env"
SRPM="$BUILD_DIR/source.rpm"

curl --fail --location --retry 3 --output "$SRPM" "$SRPM_URL"
echo "$SRPM_SHA256  $SRPM" | sha256sum --check
rpm --install --nodeps --define "_topdir $BUILD_DIR" "$SRPM"
rm "$SRPM"

# Use Fedora's configuration unchanged until a TeamSBC override is selected.
# Apply the same switches when querying build requirements and building RPMs.
cat > "$BUILD_DIR/.build-args" <<EOF
--with
baseonly
--without
debuginfo
--without
efiuki
--define
buildid .teamsbc.rpi4
EOF
touch "$BUILD_DIR/.prepared"
