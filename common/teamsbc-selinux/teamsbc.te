policy_module(teamsbc,1.0)

# Allow systemd to rename files in VFAT partitions,
# see: https://github.com/teamsbc/distribution/issues/27#issuecomment-4716640670
require {
	type dosfs_t;
	type init_t;
	class file { getattr open read rename unlink };
}

allow init_t dosfs_t:file { getattr open read rename unlink };

# Allow systemd-importd (and systemd-pull, which runs in the same domain) to
# read the OpenPGP keyring used for verifying sysupdate manifests.
type systemd_import_pubring_t;
files_type(systemd_import_pubring_t)

require {
	type systemd_importd_t;
	class file { getattr open read };
}

allow systemd_importd_t systemd_import_pubring_t:file { getattr open read };

# Allow systemd-importd (systemd-pull) to write update artifacts to the ESP,
# which is a VFAT partition labeled dosfs_t.
require {
	type dosfs_t;
	class dir { search read write add_name remove_name };
	class file { create getattr setattr open read write rename unlink lock };
}

allow systemd_importd_t dosfs_t:dir { search read write add_name remove_name };
allow systemd_importd_t dosfs_t:file { create getattr setattr open read write rename unlink lock };

# Allow systemd-pull to access /proc/net and /proc/sys/net (libcurl needs
# these for networking, e.g. checking IPv6 availability) and to read/write
# the memfd used by sysupdated for capturing worker output.
require {
	type proc_net_t;
	type sysctl_net_t;
	type tmpfs_t;
	class lnk_file read;
	class dir search;
	class file { open read write };
}

allow systemd_importd_t proc_net_t:lnk_file read;
allow systemd_importd_t sysctl_net_t:dir search;
allow systemd_importd_t sysctl_net_t:file { getattr open read };
allow systemd_importd_t tmpfs_t:file { read write };

# Allow systemd-importd (systemd-pull) to access fixed-disk block devices
# for partition-based updates.
require {
	type fixed_disk_device_t;
	class blk_file { getattr open read write };
}

allow systemd_importd_t fixed_disk_device_t:blk_file { getattr open read write };

# Allow systemd-sysupdate and systemd-bless-boot (running as init_t) to
# access removable block devices, including microSD boot media. Sysupdate
# also needs device ioctls and locking when updating partitions.
# See: https://github.com/teamsbc/distribution/issues/78
require {
	type removable_device_t;
	class blk_file { getattr open read write ioctl lock };
}

allow init_t removable_device_t:blk_file { getattr open read write ioctl lock };

# Allow systemd-importd (systemd-pull) to write partition-based updates to
# removable media, just as it does for fixed disks.
allow systemd_importd_t removable_device_t:blk_file { getattr open read write };

# Allow systemd-importd (systemd-pull) to download system extension images
# into /var/lib/extensions, which is labeled init_var_lib_t. Include access
# to rename completed downloads and remove partial or obsolete images.
require {
	type init_var_lib_t;
	class dir { getattr open read search write add_name remove_name };
	class file { create getattr setattr open read write rename unlink lock };
}

allow systemd_importd_t init_var_lib_t:dir { getattr open read search write add_name remove_name };
allow systemd_importd_t init_var_lib_t:file { create getattr setattr open read write rename unlink lock };
