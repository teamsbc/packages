[Transfer]
ProtectVersion=%A
Features=nvme-cli

[Source]
Type=url-file
Path=https://extensions.teamsbc.net/main/@@DIST_VERSION@@/@@BASEARCH@@/@@IMAGE_ID@@/
MatchPattern=@@IMAGE_ID@@-@v.nvme-cli.sysext.erofs

[Target]
Type=regular-file
Path=/var/lib/extensions
MatchPattern=nvme-cli_@v.sysext.raw
Mode=0444
InstancesMax=2
