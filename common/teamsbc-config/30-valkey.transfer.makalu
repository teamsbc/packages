[Transfer]
ProtectVersion=%A
Features=valkey

[Source]
Type=url-file
Path=https://extensions.teamsbc.net/main/@@DIST_VERSION@@/@@BASEARCH@@/@@IMAGE_ID@@/
MatchPattern=@@IMAGE_ID@@-@v.valkey.sysext.erofs

[Target]
Type=regular-file
Path=/var/lib/extensions
MatchPattern=valkey_@v.sysext.raw
Mode=0444
InstancesMax=2
