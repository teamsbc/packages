[Transfer]
ProtectVersion=%A
Features=lm_sensors

[Source]
Type=url-file
Path=https://extensions.teamsbc.net/main/@@DIST_VERSION@@/@@BASEARCH@@/@@IMAGE_ID@@/
MatchPattern=@@IMAGE_ID@@-@v.lm_sensors.sysext.erofs

[Target]
Type=regular-file
Path=/var/lib/extensions
MatchPattern=lm_sensors_@v.sysext.raw
Mode=0444
InstancesMax=2
