[Transfer]
ProtectVersion=%A
Features=nmap

[Source]
Type=url-file
Path=https://extensions.teamsbc.net/main/@@DIST_VERSION@@/@@BASEARCH@@/@@IMAGE_ID@@/
MatchPattern=@@IMAGE_ID@@-@v.nmap.sysext.erofs

[Target]
Type=regular-file
Path=/var/lib/extensions
MatchPattern=nmap_@v.sysext.raw
Mode=0444
InstancesMax=2
