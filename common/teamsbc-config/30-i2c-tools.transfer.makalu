[Transfer]
ProtectVersion=%A
Features=i2c-tools

[Source]
Type=url-file
Path=https://extensions.teamsbc.net/main/@@DIST_VERSION@@/@@BASEARCH@@/@@IMAGE_ID@@/
MatchPattern=@@IMAGE_ID@@-@v.i2c-tools.sysext.erofs

[Target]
Type=regular-file
Path=/var/lib/extensions
MatchPattern=i2c-tools_@v.sysext.raw
Mode=0444
InstancesMax=2
